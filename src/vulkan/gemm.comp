#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer BufA {
    float A[];
};

layout(std430, binding = 1) readonly buffer BufB {
    float B[];
};

layout(std430, binding = 2) writeonly buffer BufC {
    float C[];
};

layout(push_constant) uniform Dimensions {
    uint M;
    uint N;
    uint K;
} dim;

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;

    if (row < dim.M && col < dim.N) {
        float sum = 0.0;
        uint a_row = row * dim.K;
        for (uint k = 0; k < dim.K; ++k) {
            sum += A[a_row + k] * B[k * dim.N + col];
        }
        C[row * dim.N + col] = sum;
    }
}
